# Development and Vercel environment examples.
# On Vercel Preview/Production, prefer API_URL so the same-origin auth proxy can use the server-side backend URL.
API_URL=https://decoda-rwa-guard-api-production.up.railway.app
# The browser never calls the API directly: client code uses the same-origin proxy
# /api/backend, which attaches the session from the HttpOnly cookie server-side.
# NEXT_PUBLIC_API_URL is a fallback for API_URL (server-side) and the API docs links.
NEXT_PUBLIC_API_URL=https://decoda-rwa-guard-api-production.up.railway.app
NEXT_PUBLIC_API_TIMEOUT_MS=5000
NEXT_PUBLIC_LIVE_MODE_ENABLED=false
# Localhost fallback is disabled by default and must be explicitly opted into for local development only.
ALLOW_LOCAL_API_FALLBACK=false

# Local development override example:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Public contact email shown in marketing CTA
NEXT_PUBLIC_SUPPORT_EMAIL=support@decodasecurity.com

# Shared Decoda identity (docs/SHARED_IDENTITY.md). Same mode as the API:
# legacy (default) | dual | workos. Without the WorkOS settings, "Sign in to
# Decoda" is unavailable — there is no fallback to the password form in workos mode.
GUARD_IDENTITY_MODE=legacy
# GUARD_LEGACY_PASSWORD_SUNSET=2027-01-31T00:00:00Z
# WORKOS_CLIENT_ID=
# WORKOS_API_KEY=
# WORKOS_COOKIE_PASSWORD=               # ≥32 characters
# Inlined at build time; must match the redirect URI registered in WorkOS.
# NEXT_PUBLIC_WORKOS_REDIRECT_URI=https://rwa.decodasecurity.com/auth/callback
# GUARD_BFF_SHARED_SECRET=              # same value as the API
# DECODA_WEBSITE_URL=https://www.decodasecurity.com
# Vault's origin (the host of its WorkOS redirect URI); the switcher opens <origin>/auth/sign-in.
# DECODA_VAULT_URL=https://vault.decodasecurity.com
